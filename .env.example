# Copy to .env and fill in the two secrets.
POSTGRES_DB=esports
POSTGRES_USER=esports
POSTGRES_PASSWORD=change_me

DJANGO_SECRET_KEY=change_me_to_a_long_random_string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

APP_PORT=8000
# Add demo teams, players, tournaments and matches when the database is empty
SEED_DEMO_DATA=true
